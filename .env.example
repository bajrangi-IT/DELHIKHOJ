# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: seeds an admin account at first start (otherwise only the demo admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enables LLM-written answers in the assistant (OpenAI-compatible endpoint).
# Without these, the assistant uses deterministic retrieval from the sourced destination database.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: routing provider (defaults to the public OSRM demo server; use your own for production)
OSRM_BASE_URL=https://router.project-osrm.org
